{
  "platform": "github",
  "repository": "AustinXT/AustinXT.github.io",
  "testCommands": [
    "python3 -I scripts/check-manifests.py .",
    "python3 -I scripts/check-system.py",
    "python3 -I scripts/test-check-system.py",
    "python3 -I scripts/check-reading-prototype.py",
    "python3 -I scripts/test-reading-prototype.py",
    "python3 -I scripts/test-site-export.py",
    "python3 -I scripts/test-content-export.py",
    "python3 -I scripts/test-migration.py",
    "python3 -I scripts/check-migration.py",
    "node --test scripts/test-content-loader.mjs",
    "npm --prefix src/site run lint",
    "npm --prefix src/site run typecheck",
    "NEXT_TELEMETRY_DISABLED=1 npm --prefix src/site run build",
    "python3 -I scripts/check-site-export.py",
    "python3 -I scripts/check-content-export.py"
  ],
  "name": "manzi-blog",
  "base": "origin/dev",
  "worktreeDirectory": "../worktrees/manzi-blog-ai-dev"
}
